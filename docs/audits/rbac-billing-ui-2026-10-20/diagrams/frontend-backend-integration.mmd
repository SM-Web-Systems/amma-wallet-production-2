graph LR
    subgraph "Frontend (React)"
        subgraph "Shared"
            AA["lib/admin-api.ts<br/>adminFetch() + getAdminInfo()"]
        end

        subgraph "Pages"
            P1["AdminLogin.tsx<br/>Raw fetch (no auth)"]
            P2["AdminConsole.tsx"]
            P3["AdminTenantDetail.tsx"]
            P4["AdminAdmins.tsx"]
        end

