# Copy to packages/backend/.env for local development.
# NEVER commit .env — it is gitignored.
# Production secrets are managed in amma-wallet-docker/app.env (not in this repo).

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://stellarwallet:changeme@localhost:5432/stellarwallet

# --- JWT (end-user sessions) ---
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token TTL in seconds (default: 900 = 15 min access, 604800 = 7 days refresh)
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- Admin JWT (internal admin panel — separate from user tokens) ---
# Generate with: openssl rand -hex 64
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=3600

# --- Stellar / Horizon ---
# "public" for mainnet, "testnet" for staging
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Platform wallet (Stellar keypair) ---
# The platform operations wallet that pays activation fees
# Public key (G...) — shown in UI and stellar.toml
PLATFORM_WALLET=
# Secret key (S...) — NEVER log, print, or commit
PLATFORM_SECRET=

# --- Signing keypair (Stellar SEP-0010 challenge signing) ---
SIGNING_PUBLIC_KEY=
# Secret key — NEVER log, print, or commit
SIGNING_SECRET_KEY=

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- API keys (comma-separated) ---
# Server-to-server keys for integrations (e.g. LMS → wallet)
# Must match AMMA_WALLET_API_KEY in LMS .env
API_KEYS=

# --- SSO (Amma Wallet acts as Identity Provider for LMS) ---
# Shared secret — must match AMMA_SSO_STATE_SECRET in LMS .env
SSO_SECRET=
# Comma-separated allowed callback URL prefixes
SSO_CALLBACK_WHITELIST=https://lms.smwebsystems.com

# --- SMTP ---
SMTP_HOST=mail.smwebsystems.com
SMTP_PORT=587
SMTP_USER=noreply.smwebsystems
# App password or SMTP credential — NEVER commit
SMTP_PASS=
SMTP_FROM=Amma Wallet <noreply@ammawallet.com>

# --- Web app URLs (for CORS and redirect generation) ---
WEB_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001

# --- VAPID (web push notifications — optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Optional: Stripe Crypto Onramp ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_ONRAMP_ENABLED=false

# --- Optional: Transak ---
TRANSAK_API_KEY=
TRANSAK_ENVIRONMENT=STAGING
TRANSAK_ENABLED=false
