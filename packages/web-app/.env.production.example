# Copy to .env.production for production builds.
# NEVER commit .env.production — it is gitignored.
#
# These VITE_ variables are baked into the frontend bundle at build time.
# They are PUBLIC — do not put any secret keys here.

# Public API base URL served by nginx (no trailing slash)
VITE_API_URL=https://api.ammawallet.com

# Platform wallet PUBLIC key (Stellar G-address — this is NOT the secret key)
# Find in amma-wallet-docker/app.env as PLATFORM_WALLET
VITE_PLATFORM_WALLET=G...your_platform_wallet_public_key_here...

# Cloudflare Turnstile site key (public — safe to include in builds)
# Find the widget at: https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=

# Default Stellar network for the frontend
# "public" = mainnet (production), "testnet" = staging/testnet
VITE_DEFAULT_NETWORK=public
