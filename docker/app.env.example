# Template for amma-wallet-docker/app.env (production Docker stack).
# The real app.env lives OUTSIDE this repo at /home/webadmin/amma-wallet-docker/app.env.
# NEVER commit app.env or any file containing real secrets.
#
# Usage:
#   cp docker/app.env.example /path/to/amma-wallet-docker/app.env
#   # Fill in all blank values from your secrets manager before running:
#   docker compose up -d

NODE_ENV=production
PORT=3001

# Stellar network — "public" for mainnet, "testnet" for isolated staging
STELLAR_NETWORK=public
HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://soroban-rpc.stellar.org

# DATABASE_URL must be set in docker-compose.yml `environment:` block using $$ escaping
# to prevent Docker Compose interpolation. Do NOT put DATABASE_URL here.
# Example in docker-compose.yml:
#   environment:
#     DATABASE_URL: "postgresql://user:pass@db:5432/stellarwallet"

# JWT secrets — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Admin JWT — separate from user tokens
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=3600

# Platform wallet
PLATFORM_WALLET=
PLATFORM_SECRET=

# Signing keypair (SEP-0010)
SIGNING_PUBLIC_KEY=
SIGNING_SECRET_KEY=

# Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Server-to-server API keys (comma-separated)
API_KEYS=

# SSO
SSO_SECRET=
SSO_CALLBACK_WHITELIST=https://lms.smwebsystems.com

# SMTP
SMTP_HOST=mail.smwebsystems.com
SMTP_PORT=587
SMTP_USER=noreply.smwebsystems
SMTP_PASS=
SMTP_FROM=Amma Wallet <noreply@ammawallet.com>

# URLs
WEB_APP_URL=https://ammawallet.com
API_BASE_URL=https://api.ammawallet.com

# Initial super_admin bootstrap (remove after first login)
# Password hash generated with bcrypt cost 12 — never put plaintext here
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD_HASH=
